PORT=5000
# Local MongoDB
# MONGO_URI=mongodb://localhost:27017/suvarn_bachat_yojana
# MongoDB Atlas (cloud — used for Render deployment)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/suvarn_bachat_yojana?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development
WHATSAPP_PROVIDER=stub
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
DAILY_JOB_CRON=0 8 * * *
REMINDER_DAYS_BEFORE=5
DEFAULT_DUE_DAY=5
